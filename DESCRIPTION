Package: bayesim
Title: Simulation Framework for Bayesian Modeling
Version: 2.0.0
URL: https://sims1253.github.io/bayesim, https://github.com/sims1253/bayesim
BugReports: https://github.com/sims1253/bayesim/issues
Authors@R: c(
    person("Maximilian", "Scholz", , "research.scholz@mailbox.org", 
           role = c("aut", "cre")),
    person("Paul-Christian", "Bürkner", , "paul.buerkner@gmail.com", 
           role = "aut")
