^.*\.Rproj$
^\.Rproj\.user$
^LICENSE\.md$
^README\.Rmd$
^doc$
^Meta$
^\.github$
^\.claude$
^_pkgdown\.yml$
^air\.toml$
^jarl\.toml$
# Ignore compiled cmdstan binaries (extensionless) shipped next to .stan sources.
^inst/stan/[^/.]+$
# Stray rendered vignette html (build artifacts; sources are the .Rmd files).
^vignettes/.*\.html$
